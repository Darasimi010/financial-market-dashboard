# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.pnpm-store/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/dist/

# misc
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# secrets
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
.eslintcache
.cache/

# environment variables (keep .env.example tracked)
.env
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# serwist / pwa generated service worker bundles (source lives in app/sw.ts)
/public/sw.js
/public/sw.js.map
/public/swe-worker-*.js
/public/swe-worker-*.js.map
/public/workbox-*.js
/public/workbox-*.js.map

# testing, coverage & bundle analyzer reports
/coverage/
*.lcov
/.nyc_output
/analyze/

# docker local data
docker-data/
postgres-data/

# local database data
*.db
*.sqlite
