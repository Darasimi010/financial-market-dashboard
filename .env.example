# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# FINNHUB_API_KEY: Required Finnhub REST API token.
# Sign up at https://finnhub.io to obtain a free tier API key.
# Server-side only; never exposed to the client browser.
FINNHUB_API_KEY="your_finnhub_api_key_here"

# STRICT_FINNHUB_KEY: Set to "true" in production to fail server startup if FINNHUB_API_KEY is missing.
STRICT_FINNHUB_KEY="false"

# ANALYZE: Set to "true" when running next build to generate bundle analyzer reports.
ANALYZE="false"
